{
  "name": "credit-follow",
  "version": "0.1.0",
  "private": true,
  "description": "Credit Follow — personal finance tracking app (monorepo)",
  "workspaces": [
    "packages/*",
    "services/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10"
  },
  "scripts": {
    "postinstall": "npm run build -w @credit-follow/shared",
    "build": "npm run build -w @credit-follow/shared && npm run build -w @credit-follow/api",
    "dev:api": "npm run dev -w @credit-follow/api",
    "dev:mobile": "npm run start -w @credit-follow/mobile",
    "start:api": "npm run start -w @credit-follow/api",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.0",
    "globals": "^16.0.0",
    "prettier": "^3.6.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0"
  }
}
