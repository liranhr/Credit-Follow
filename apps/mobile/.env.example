# Copy this file to `.env` and adjust. Never commit `.env`.
# Only variables prefixed with EXPO_PUBLIC_ are exposed to the app bundle —
# they are visible to anyone with the app, so never put secrets here.

# Base URL of the Credit Follow API.
# Android emulator: http://10.0.2.2:4000 | iOS simulator / web: http://localhost:4000
# Physical device: http://<your-computer-LAN-IP>:4000
EXPO_PUBLIC_API_URL=http://localhost:4000

# --- Google sign-in (requires a development build; not available in Expo Go) ---
# OAuth client ID of type "Web application" (the API verifies ID tokens against it)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# OAuth client ID of type "iOS" (iOS only)
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# --- Facebook login (requires a development build) ---
# Set to true after setting FACEBOOK_APP_ID / FACEBOOK_CLIENT_TOKEN below and rebuilding
EXPO_PUBLIC_FACEBOOK_ENABLED=false

# --- Development-only login button (also needs AUTH_DEV_LOGIN_ENABLED=true in the API) ---
EXPO_PUBLIC_DEV_LOGIN=false

# --- Native build configuration (read by app.config.ts at prebuild / build time) ---
# iOS bundle identifier and Android package name
APP_BUNDLE_ID=com.creditfollow.app
# Reversed iOS client ID, e.g. com.googleusercontent.apps.1234567890-abcdef
GOOGLE_IOS_URL_SCHEME=
# Facebook app ID and client token (App settings → Advanced → Client token)
FACEBOOK_APP_ID=
FACEBOOK_CLIENT_TOKEN=
