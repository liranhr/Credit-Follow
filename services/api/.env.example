# Copy this file to `.env` and fill in real values. Never commit `.env`.

# development | test | production
NODE_ENV=development

# Port the API listens on
PORT=4000

# MongoDB connection string (local MongoDB or MongoDB Atlas).
# Local example:  mongodb://127.0.0.1:27017/credit-follow
# Atlas example:  mongodb+srv://<username>:<password>@<cluster-host>/credit-follow
MONGODB_URI=mongodb://127.0.0.1:27017/credit-follow

# Comma-separated list of allowed browser origins (leave empty to allow all in development)
CORS_ORIGINS=http://localhost:8081

# Set to true when running behind a reverse proxy / load balancer
TRUST_PROXY=false

# ---------------------------------------------------------------------------
# Sessions
# ---------------------------------------------------------------------------
# REQUIRED. Secret used to sign access tokens — at least 32 random characters.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# The API refuses to start while this is empty.
JWT_SECRET=

# Access token lifetime in seconds (default 900 = 15 minutes)
ACCESS_TOKEN_TTL_SECONDS=900
# Refresh token / session lifetime in days (default 30)
REFRESH_TOKEN_TTL_DAYS=30

# ---------------------------------------------------------------------------
# Google sign-in (leave empty to disable)
# ---------------------------------------------------------------------------
# Comma-separated OAuth client IDs accepted as the ID token audience:
# the *Web application* client ID (the app's `webClientId`, used on Android), plus the
# *iOS* client ID (iOS ID tokens may carry it as the audience). Example:
#   GOOGLE_CLIENT_IDS=<web-client-id>.apps.googleusercontent.com,<ios-client-id>.apps.googleusercontent.com
GOOGLE_CLIENT_IDS=

# ---------------------------------------------------------------------------
# Facebook login (leave both empty to disable; they must be set together)
# ---------------------------------------------------------------------------
FACEBOOK_APP_ID=
# App secret: Facebook developer dashboard → App settings → Basic. Server-side only!
FACEBOOK_APP_SECRET=
FACEBOOK_GRAPH_API_VERSION=v24.0

# ---------------------------------------------------------------------------
# Development-only passwordless login (POST /auth/dev). Lets you use the app in
# Expo Go / web before Google & Facebook are configured. Refused when NODE_ENV=production.
# ---------------------------------------------------------------------------
AUTH_DEV_LOGIN_ENABLED=false
